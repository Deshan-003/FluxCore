// scale: out[i] = a * x[i]
// Param order: .u64 pX, .u64 pOut, .f32 pA, .u32 pN
.version 7.0
.target sm_75
.address_size 64

.visible .entry scale(
    .param .u64 pX,
    .param .u64 pOut,
    .param .f32 pA,
    .param .u32 pN
)
{
    .reg .pred %p<2>;
    .reg .f32  %f<5>;
    .reg .b32  %r<6>;
    .reg .b64  %rd<6>;

    ld.param.u64  %rd1, [pX];
    ld.param.u64  %rd2, [pOut];
    ld.param.f32  %f1,  [pA];
    ld.param.u32  %r1,  [pN];

    mov.u32       %r2, %ctaid.x;
    mov.u32       %r3, %ntid.x;
    mov.u32       %r4, %tid.x;
    mad.lo.s32    %r5, %r2, %r3, %r4;   // i
